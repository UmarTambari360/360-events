{
  "$schema": "../../package.schema.json",
  "name": "@360events/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "development": "./src/public.ts",
      "import": "./dist/public.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "development": "./src/db/index.ts",
      "import": "./dist/db/index.js"
    },
    "./logger": {
      "types": "./dist/lib/logger.d.ts",
      "development": "./src/lib/logger.ts",
      "import": "./dist/lib/logger.js"
    },
    "./jobs": {
      "types": "./dist/lib/jobs.d.ts",
      "development": "./src/lib/jobs.ts",
      "import": "./dist/lib/jobs.js"
    },
    "./schema": {
      "types": "./dist/db/schema/index.d.ts",
      "development": "./src/db/schema/index.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./database-url": {
      "types": "./dist/config/database-url.d.ts",
      "development": "./src/config/database-url.ts",
      "import": "./dist/config/database-url.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drift-check": "drizzle-kit check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pino-http": "^6.1.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@360events/types": "workspace:^",
    "@360events/validators": "workspace:^",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^4.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  }
}
